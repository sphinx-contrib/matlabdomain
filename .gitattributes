# Normalize line endings to LF for all text files
# This ensures consistent behavior across Windows, macOS, and Linux

# Every text file, also without a rule below; wins over core.autocrlf
* text=auto eol=lf

# Source code
*.py text eol=lf
*.m text eol=lf

# Documentation
*.rst text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.jinja text eol=lf

# Configuration files
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
uv.lock text eol=lf

# Data files
*.json text eol=lf
*.xml text eol=lf

# Shell scripts
*.sh text eol=lf

# Batch files: cmd.exe misreads labels in LF-only files
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files (no line ending conversion)
*.mlapp binary
# Simulink files: test fixtures must keep the bytes MATLAB wrote
*.slx binary
*.mdl binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
