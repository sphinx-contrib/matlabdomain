{#- sphinx-matlab-apidoc: the page of one folder (plan.md Section 2.8).
    Copy this file to a folder and pass it with -t/--templatedir to change
    the output. Context keys are listed in the documentation.
    The toctree macro is adapted from Sphinx's apidoc templates
    (sphinx/templates/apidoc/package.rst.jinja), Copyright (c) 2007-2026 by
    the Sphinx team, BSD-2-Clause. -#}
{%- macro toctree(docnames) -%}
.. toctree::
   :maxdepth: {{ maxdepth }}
{% for docname in docnames %}
   {{ docname }}
{%- endfor %}
{%- endmacro -%}

{%- macro autodoc(entry) -%}
.. {{ entry.directive }}:: {{ entry.ref }}
{%- for name, value in entry.options.items() %}
   :{{ name }}:{% if value %} {{ value }}{% endif %}
{%- endfor %}
{%- endmacro -%}

{{ title | e | heading }}

.. mat:autofolder:: {{ ref }}
{%- if sections or pages %}

.. contents::
   :local:
   :backlinks: none
{%- endif %}
{%- if readme %}

.. mat:autopage:: {{ readme }}
   :no-title:
{%- endif %}
{%- for section, entries in sections %}

{{ section | e | heading(2) }}
{%- if separate %}

{{ toctree(entries | map(attribute="docname")) }}
{%- else %}
{%- for entry in entries %}

{{ entry.title | e | heading(3) }}

{{ autodoc(entry) }}
{%- endfor %}
{%- endif %}
{%- endfor %}
{%- if pages %}

{{ "Pages" | heading(2) }}

{{ toctree(pages | map(attribute="docname")) }}
{%- endif %}
{%- if subfolders %}

{{ "Folders" | heading(2) }}

{{ toctree(subfolders) }}
{%- endif %}
